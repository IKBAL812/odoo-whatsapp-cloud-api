<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="whatsapp_cloud_api_backend.WhatsAppSystray" owl="1">
        <div t-if="state.hasAccess">
            <button
                class="o_whatsapp_systray"
                t-on-click="openWhatsApp"
                title="Open WhatsApp"
            >
                <i class="fa fa-whatsapp" />
                <span t-if="state.unreadCount > 0" class="badge">
                    <t t-esc="state.unreadCount > 99 ? '99+' : state.unreadCount" />
                </span>
            </button>
        </div>
    </t>

</templates>
