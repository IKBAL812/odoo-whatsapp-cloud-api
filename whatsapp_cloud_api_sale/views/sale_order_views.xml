<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action to open WhatsApp Composer from Sale Order -->
    <record id="action_sale_order_send_whatsapp" model="ir.actions.act_window">
        <field name="name">Send WhatsApp Template</field>
        <field name="res_model">whatsapp.composer</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="whatsapp_cloud_api_backend.whatsapp_composer_form_view"/>
        <field name="target">new</field>
        <field name="context">{'default_res_model': 'sale.order', 'default_res_id': active_id}</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
    </record>

    <!-- Add button to Sale Order form view -->
    <record id="sale_order_form_whatsapp_button" model="ir.ui.view">
        <field name="name">sale.order.form.whatsapp.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_quotation_send']" position="after">
                <button name="%(action_sale_order_send_whatsapp)d"
                        string="Send WhatsApp"
                        type="action"
                        class="btn-primary"
                        icon="fa-whatsapp"
                        groups="whatsapp_cloud_api_backend.group_whatsapp_backend_user"
                        attrs="{'invisible': [('state', 'not in', ['draft'])]}"/>
            </xpath>
        </field>
    </record>
</odoo>
