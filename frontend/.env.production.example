# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Odoo JSON-RPC Connection Settings
ODOO_JSONRPC_PROTOCOL=https
ODOO_JSONRPC_HOST=your-odoo-domain.com
ODOO_JSONRPC_PORT=443
ODOO_JSONRPC_DATABASE=your_production_database

# Note: Do NOT commit .env.production to version control
# This file contains sensitive production credentials
